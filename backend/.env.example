# FastAPI
PMFA_APP_ENV=development
PMFA_APP_DEBUG=true
PMFA_APP_CORS_ORIGINS=["http://localhost:5173"]

# SQLite (Phase 2) — relative path resolved from backend/
PMFA_DB_URL=sqlite:///./pmfa.db

# Rules engine — relative to backend/ working directory
PMFA_RULES_JSON_PATH=../KNOWLEDGE/movement_analysis_rules.json

# Anthropic — Claude Sonnet coaching cue generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AWS S3 (required only for /upload endpoint)
PMFA_AWS_ACCESS_KEY_ID=your-key-here
PMFA_AWS_SECRET_ACCESS_KEY=your-secret-here
PMFA_AWS_S3_BUCKET=pmfa-uploads
PMFA_AWS_S3_REGION=us-east-1
PMFA_AWS_S3_PRESIGN_EXPIRY_SECONDS=3600
